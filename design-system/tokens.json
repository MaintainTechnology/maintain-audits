{
  "$meta": {
    "name": "Maintain Audits Design Tokens",
    "sources": ["maintainaudits.com.au (live CSS variables)", "audits/ (all PDFs + DOCX)"],
    "spec": "../DESIGN.md",
    "note": "Brand token names preserved from the brand's own definitions. Build against `semantic` roles, not raw brand values."
  },
  "brand": {
    "black": "#101820",
    "black-2": "#0C1319",
    "black-3": "#1A2330",
    "forge-blue": "#07272D",
    "blue-deep": "#051F24",
    "blue-light": "#66A1AB",
    "assurance-green": "#3DDC84",
    "signal-green": "#06F285",
    "green-deep": "#157A40",
    "green-dark": "#0C4A26",
    "green-mid": "#348F41",
    "green-tint-1": "#E5F8EE",
    "green-tint-2": "#CCEFD3",
    "cloud": "#F5F5F1",
    "white": "#FFFFFF",
    "ink": "#1F2D2B",
    "slate": "#64748B",
    "surface-mint-1": "#F0FBF5",
    "surface-mint-2": "#EAF7F0"
  },
  "semantic": {
    "bg": "forge-blue", "bg-deep": "black", "surface": "white", "surface-soft": "cloud",
    "text": "ink", "text-muted": "slate", "primary": "assurance-green",
    "primary-ink": "forge-blue", "accent": "signal-green",
    "on-dark": "#FFFFFF", "on-dark-muted": "rgba(255,255,255,0.70)", "on-dark-faint": "rgba(255,255,255,0.55)"
  },
  "severity": {
    "pass":     { "fg": "#0C4A26", "bg": "#E5F8EE" },
    "low":      { "fg": "#1E40AF", "bg": "#DBEAFE", "bg_inferred": true },
    "medium":   { "fg": "#854D0E", "bg": "#FEF9C3" },
    "high":     { "fg": "#9A3412", "bg": "#FFEDD5" },
    "critical": { "fg": "#991B1B", "bg": "#FEE2E2" }
  },
  "typography": {
    "display": "Albert Sans", "body": "Inter", "social-alt": "Vela Sans",
    "tracking": { "display": "-0.02em", "tight": "-0.01em" },
    "leading": { "display": 1.05, "body": 1.6 },
    "scale": {
      "display": "clamp(2.75rem,6vw,4.5rem)", "h1": "clamp(2rem,4vw,3rem)",
      "h2": "clamp(1.5rem,3vw,2rem)", "h3": "1.375rem", "h4": "1.125rem",
      "body-lg": "1.125rem", "body": "1rem", "sm": "0.875rem", "xs": "0.75rem", "overline": "0.6875rem"
    },
    "weights": { "display": [700, 800], "body": [400, 500, 600] }
  },
  "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "24px", "6": "32px", "7": "48px", "8": "64px", "9": "96px", "10": "128px" },
  "radius": { "sharp": "0", "sm": "6px", "md": "10px", "lg": "16px", "xl": "24px", "pill": "999px" },
  "shadow": {
    "sm": "0 1px 2px rgba(7,39,45,.08)", "md": "0 6px 20px rgba(7,39,45,.12)",
    "lg": "0 20px 50px rgba(5,31,36,.35)", "glow-green": "0 0 40px rgba(61,220,132,.25)"
  },
  "background": {
    "grid-line": "rgba(61,220,132,0.05)", "grid-size": "40px",
    "grid": "linear-gradient(var(--grid-line) 1px, transparent 1px), linear-gradient(90deg, var(--grid-line) 1px, transparent 1px)",
    "glow": "radial-gradient(60% 60% at 70% 18%, rgba(61,220,132,.18), transparent 70%)"
  },
  "motion": { "fast": "120ms", "base": "200ms", "slow": "320ms", "ease-out": "cubic-bezier(0.22,1,0.36,1)" },
  "assets": {
    "logo": { "wordmark-on-dark": "assets/logo/wordmark-on-dark.svg", "wordmark-on-light": "assets/logo/wordmark-on-light.svg" },
    "icons": "assets/icons/ (i-check, i-clipboard, i-search, i-shield, i-chart, i-network, i-speed, i-star, i-cpu, i-mail, i-phone, i-pin, i-arrow-right, i-menu)",
    "sprite": "assets/sprite.svg"
  }
}
